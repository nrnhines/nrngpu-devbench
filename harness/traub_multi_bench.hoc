// Traub multi-psolve bench: same as init.hoc but 3× prun() with markers.
// prun() itself stdinit+psolve (parlib.hoc), so i=0 cold, i=1,2 warm.
//
// Usage (from ~/models/82894):
//   special -c one_tenth_ncell=1 -c use_gap=0 -c nthread=1 -c mytstop=100 \
//     -c enable_gpu=0 -c coreneuron=0 -c benchmark_quiet=1 \
//     /path/to/traub_multi_bench.hoc

setuptime = startsw()
{xopen("hoc/defvar.hoc")}

default_var("load_balance_phase", 0)
default_var("one_tenth_ncell", 1)
default_var("use_gap", 0)
default_var("use_ectopic", 1)
default_var("use_inject", 1)
default_var("awake", 1)
default_var("default_delay", 0.5)
default_var("ranseedbase", 1)
default_var("use_traubexact", 0)
default_var("wholecell_prefix", "cxwhole")
default_var("multisplit_prefix", "cx")
default_var("multisplit_nhost", 256)
default_var("msoptfactor", 0.8)
default_var("nthread", 1)
default_var("savestatetest", 0)
default_var("coreneuron", 0)
default_var("coreneuron_gpu", 0)
default_var("enable_gpu", 0)
default_var("gpu_backend", "native")
default_var("gpu_download_flush", 1)
default_var("benchmark_quiet", 1)
default_var("prcellstate_gid", -1)
default_var("prcellstate_checkpoint", -1)
default_var("spike_compress", 5)
default_var("cacheeffic", 1)
default_var("multisend", 0)
default_var("selfevents", 0)
default_var("fakerank", -1)
default_var("fakenhost", -1)
default_var("n_multi_psolve", 3)

gfac_AMPA = 1
gfac_NMDA = 1
gfac_GABAA = 1
use_p2c_net_connections = 0

{localloadfile("manage_setup.hoc")}

steps_per_ms = 40
dt = .025
secondorder = 2
default_var("mytstop", 100)
tstop = mytstop

if (0) { pc.runworker()  pc.done() quit() }

if (coreneuron) {
    if (nrnpython("")) {
        nrnpython("from neuron import coreneuron")
        nrnpython("coreneuron.enable = True")
        if (coreneuron_gpu) {
            nrnpython("coreneuron.gpu = True")
            nrnpython("coreneuron.permute = 2")
        } else {
            nrnpython("coreneuron.gpu = False")
            nrnpython("coreneuron.permute = 1")
        }
    } else {
        execerror("coreneuron not installed")
    }
}

pc.optimize_node_order(2)
if (enable_gpu) {
    if (coreneuron) {
        execerror("enable_gpu=1 is native GPU only; use coreneuron_gpu=1 for CoreNEURON GPU")
    }
    pc.gpu_enable(1)
    pc.gpu_backend(gpu_backend)
    pc.gpu_download_flush_interval(gpu_download_flush)
    print pc.gpu_fixed_step_phases()
}

for i = 0, n_multi_psolve - 1 {
    if (i == n_multi_psolve - 1) {
        pnm.spikevec.resize(0)
        pnm.idvec.resize(0)
    }
    prun()
    if (pc.id == 0) {
        printf("MULTI_PSOLVE i=%d runtime=%g\n", i, runtime)
        printf("BENCHMARK runtime=%g setuptime=%g ncell=%d enable_gpu=%d nhost=%d rep=%d\n", \
            runtime, setuptime, pnm.ncell, enable_gpu, pnm.nhost, i)
    }
}

// Last-psolve raster (out<nhost>.dat in cwd; run_matrix.sh moves it to NRN_SPIKE_OUT_DIR).
spike2file()
if (pc.id == 0) {
    print "tstop = ", tstop
    printf("MULTI_PSOLVE_DONE n=%d\n", n_multi_psolve)
    printf("IDENTITY_N=%d file=out%d.dat\n", pnm.spikevec.size, pnm.nhost)
}

getstat()
{pc.done()}
if (!serial) { quit() }
